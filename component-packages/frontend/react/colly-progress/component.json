{
  "id": "colly-progress",
  "name": "Progress Bar",
  "description": "Import ConfiguredComponent.tsx into your screen.",
  "category": [
    "Frontend",
    "Colly UI",
    "Feedback"
  ],
  "frameworks": [
    "next-js",
    "react-vite"
  ],
  "technologies": [
    "React",
    "shadcn",
    "Radix UI"
  ],
  "activation": "inspect",
  "defaultDirectory": "src/app/library/progress",
  "preview": true,
  "configTarget": "settings.json",
  "fields": [
    {
      "key": "previewTitle",
      "label": "Preview title",
      "defaultValue": "Progress Bar"
    },
    {
      "key": "initial",
      "label": "Initial percent",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    {
      "key": "step",
      "label": "Increment",
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    {
      "key": "label",
      "label": "Label"
    }
  ],
  "usage": "Import ConfiguredComponent.tsx into your screen.",
  "requiresNpm": [
    "react",
    "react-dom",
    "radix-ui"
  ],
  "viteDependencies": {
    "radix-ui": "^1.4.3"
  },
  "files": [
    {
      "source": "template/ConfiguredComponent.tsx",
      "target": "ConfiguredComponent.tsx"
    },
    {
      "source": "template/page.tsx",
      "target": "page.tsx"
    },
    {
      "source": "template/settings.json",
      "target": "settings.json"
    }
  ],
  "viteFiles": [
    {
      "source": "template/preview.html",
      "target": "preview.html",
      "shared": true
    },
    {
      "source": "template/preview.tsx",
      "target": "preview.tsx",
      "shared": true
    },
    {
      "source": "template/colly.css",
      "target": "colly.css",
      "shared": true
    }
  ]
}
