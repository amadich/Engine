{
  "id": "colly-dropdown",
  "name": "Dropdown Menu",
  "description": "Colly UI · Next.js and React + Vite",
  "frameworks": [
    "next-js",
    "react-vite"
  ],
  "category": [
    "Frontend",
    "Colly UI",
    "Navigation"
  ],
  "activation": "inspect",
  "defaultDirectory": "src/app/library/dropdown",
  "preview": true,
  "configTarget": "settings.json",
  "settingsHint": "These values drive the live example and the reusable ConfiguredComponent export.",
  "fields": [
    {
      "key": "previewTitle",
      "label": "Preview title",
      "defaultValue": "Dropdown Menu"
    },
    {
      "key": "label",
      "label": "Label"
    },
    {
      "key": "firstOption",
      "label": "First option"
    },
    {
      "key": "secondOption",
      "label": "Second option"
    }
  ],
  "files": [
    {
      "source": "template/LICENSE",
      "target": "LICENSE"
    },
    {
      "source": "template/button.tsx",
      "target": "button.tsx"
    },
    {
      "source": "template/dropdown-menu.tsx",
      "target": "dropdown-menu.tsx"
    },
    {
      "source": "template/page.tsx",
      "target": "page.tsx"
    },
    {
      "source": "template/settings.json",
      "target": "settings.json"
    },
    {
      "source": "template/utils.ts",
      "target": "utils.ts"
    },
    {
      "source": "template/ConfiguredComponent.tsx",
      "target": "ConfiguredComponent.tsx"
    }
  ],
  "requiresNpm": [
    "class-variance-authority",
    "clsx",
    "lucide-react",
    "radix-ui",
    "react",
    "react-dom",
    "tailwind-merge"
  ],
  "viteDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.5.0"
  },
  "viteFiles": [
    {
      "source": "template/preview.html",
      "target": "preview.html",
      "shared": true
    },
    {
      "source": "template/preview.tsx",
      "target": "preview.tsx",
      "shared": true
    },
    {
      "source": "template/colly.css",
      "target": "colly.css",
      "shared": true
    }
  ],
  "technologies": [
    "React",
    "shadcn",
    "Radix UI"
  ]
}
