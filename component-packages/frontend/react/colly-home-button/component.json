{
  "id": "colly-home-button",
  "name": "Home Button",
  "description": "Colly UI · Next.js and React + Vite",
  "frameworks": [
    "next-js",
    "react-vite"
  ],
  "category": [
    "Frontend",
    "Colly UI",
    "Navigation"
  ],
  "activation": "inspect",
  "defaultDirectory": "src/app/library/home-button",
  "preview": true,
  "configTarget": "settings.json",
  "settingsHint": "These values drive the live example and the reusable ConfiguredComponent export.",
  "fields": [
    {
      "key": "previewTitle",
      "label": "Preview title",
      "defaultValue": "Home Button"
    },
    {
      "key": "label",
      "label": "Label"
    },
    {
      "key": "destination",
      "label": "Destination",
      "pattern": "^/(?![/\\\\])[a-zA-Z0-9/_#?&=.%~-]*$"
    }
  ],
  "files": [
    {
      "source": "template/page.tsx",
      "target": "page.tsx"
    },
    {
      "source": "template/settings.json",
      "target": "settings.json"
    },
    {
      "source": "template/ConfiguredComponent.tsx",
      "target": "ConfiguredComponent.tsx"
    }
  ],
  "requiresNpm": [
    "lucide-react",
    "motion",
    "react",
    "react-dom"
  ],
  "viteDependencies": {
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0"
  },
  "viteFiles": [
    {
      "source": "template/preview.html",
      "target": "preview.html",
      "shared": true
    },
    {
      "source": "template/preview.tsx",
      "target": "preview.tsx",
      "shared": true
    },
    {
      "source": "template/colly.css",
      "target": "colly.css",
      "shared": true
    }
  ],
  "technologies": [
    "React",
    "Motion"
  ]
}
