{
  "id": "colly-navigation",
  "name": "Animated Navigation",
  "description": "Colly UI · Next.js and React + Vite",
  "frameworks": [
    "next-js",
    "react-vite"
  ],
  "category": [
    "Frontend",
    "Colly UI",
    "Navigation"
  ],
  "activation": "inspect",
  "defaultDirectory": "src/app/library/navigation",
  "preview": true,
  "configTarget": "settings.json",
  "settingsHint": "These values drive the live example and the reusable ConfiguredComponent export.",
  "fields": [
    {
      "key": "previewTitle",
      "label": "Preview title",
      "defaultValue": "Animated Navigation"
    },
    {
      "key": "brand",
      "label": "Brand"
    },
    {
      "key": "label",
      "label": "Label"
    },
    {
      "key": "href",
      "label": "Href",
      "pattern": "^/(?![/\\\\])[a-zA-Z0-9/_#?&=.%~-]*$"
    },
    {
      "key": "background",
      "label": "Background",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  ],
  "files": [
    {
      "source": "template/page.tsx",
      "target": "page.tsx"
    },
    {
      "source": "template/settings.json",
      "target": "settings.json"
    },
    {
      "source": "template/ConfiguredComponent.tsx",
      "target": "ConfiguredComponent.tsx"
    }
  ],
  "requiresNpm": [
    "@mynaui/icons-react",
    "motion",
    "react",
    "react-dom"
  ],
  "viteDependencies": {
    "@mynaui/icons-react": "^0.4.2",
    "motion": "^12.38.0"
  },
  "viteFiles": [
    {
      "source": "template/preview.html",
      "target": "preview.html",
      "shared": true
    },
    {
      "source": "template/preview.tsx",
      "target": "preview.tsx",
      "shared": true
    },
    {
      "source": "template/colly.css",
      "target": "colly.css",
      "shared": true
    }
  ],
  "technologies": [
    "React",
    "Motion",
    "Mynaui"
  ]
}
