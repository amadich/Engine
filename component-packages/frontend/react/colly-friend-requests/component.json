{
  "id": "colly-friend-requests",
  "name": "Friend Requests",
  "description": "Import ConfiguredComponent.tsx into your screen.",
  "category": [
    "Frontend",
    "Colly UI",
    "Collaboration"
  ],
  "frameworks": [
    "next-js",
    "react-vite"
  ],
  "technologies": [
    "React"
  ],
  "activation": "inspect",
  "defaultDirectory": "src/app/library/friend-requests",
  "preview": true,
  "configTarget": "settings.json",
  "fields": [
    {
      "key": "previewTitle",
      "label": "Preview title",
      "defaultValue": "Friend Requests"
    },
    {
      "key": "title",
      "label": "Title"
    },
    {
      "key": "people",
      "label": "People"
    },
    {
      "key": "empty_message",
      "label": "Empty message"
    }
  ],
  "usage": "Import ConfiguredComponent.tsx into your screen.",
  "requiresNpm": [
    "react",
    "react-dom"
  ],
  "viteDependencies": {},
  "files": [
    {
      "source": "template/ConfiguredComponent.tsx",
      "target": "ConfiguredComponent.tsx"
    },
    {
      "source": "template/page.tsx",
      "target": "page.tsx"
    },
    {
      "source": "template/settings.json",
      "target": "settings.json"
    }
  ],
  "viteFiles": [
    {
      "source": "template/preview.html",
      "target": "preview.html",
      "shared": true
    },
    {
      "source": "template/preview.tsx",
      "target": "preview.tsx",
      "shared": true
    },
    {
      "source": "template/colly.css",
      "target": "colly.css",
      "shared": true
    }
  ]
}
