{
  "id": "colly-websocket-client",
  "name": "WebSocket Client",
  "description": "Connect manually to the Express WebSocket Echo Kit or a compatible text WebSocket endpoint.",
  "category": [
    "Frontend",
    "Colly UI",
    "Integrations"
  ],
  "frameworks": [
    "next-js",
    "react-vite"
  ],
  "technologies": [
    "React",
    "WebSocket"
  ],
  "activation": "inspect",
  "defaultDirectory": "src/app/library/websocket-client",
  "preview": true,
  "configTarget": "settings.json",
  "fields": [
    {
      "key": "previewTitle",
      "label": "Preview title",
      "defaultValue": "WebSocket Client"
    },
    {
      "key": "endpoint",
      "label": "Endpoint",
      "pattern": "^wss?://[^\\s]+$"
    },
    {
      "key": "history_limit",
      "label": "History limit",
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    {
      "key": "title",
      "label": "Title"
    },
    {
      "key": "send_label",
      "label": "Send label"
    }
  ],
  "usage": "Connect manually to the Express WebSocket Echo Kit or a compatible text WebSocket endpoint.",
  "requiresNpm": [
    "react",
    "react-dom"
  ],
  "viteDependencies": {},
  "files": [
    {
      "source": "template/ConfiguredComponent.tsx",
      "target": "ConfiguredComponent.tsx"
    },
    {
      "source": "template/page.tsx",
      "target": "page.tsx"
    },
    {
      "source": "template/settings.json",
      "target": "settings.json"
    }
  ],
  "viteFiles": [
    {
      "source": "template/preview.html",
      "target": "preview.html",
      "shared": true
    },
    {
      "source": "template/preview.tsx",
      "target": "preview.tsx",
      "shared": true
    },
    {
      "source": "template/colly.css",
      "target": "colly.css",
      "shared": true
    }
  ]
}
