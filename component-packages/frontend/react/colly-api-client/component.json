{
  "id": "colly-api-client",
  "name": "HTTP API Client",
  "description": "Run the Express HTTP Status Kit or point this client at an API that permits your frontend origin.",
  "category": [
    "Frontend",
    "Colly UI",
    "Integrations"
  ],
  "frameworks": [
    "next-js",
    "react-vite"
  ],
  "technologies": [
    "React",
    "HTTP API"
  ],
  "activation": "inspect",
  "defaultDirectory": "src/app/library/api-client",
  "preview": true,
  "configTarget": "settings.json",
  "fields": [
    {
      "key": "previewTitle",
      "label": "Preview title",
      "defaultValue": "HTTP API Client"
    },
    {
      "key": "endpoint",
      "label": "Endpoint",
      "pattern": "^https?://[^\\s]+$"
    },
    {
      "key": "method",
      "label": "Method",
      "options": [
        "GET",
        "HEAD"
      ]
    },
    {
      "key": "timeout_ms",
      "label": "Timeout (ms)",
      "type": "number",
      "minimum": 100,
      "maximum": 30000
    },
    {
      "key": "title",
      "label": "Title"
    }
  ],
  "usage": "Run the Express HTTP Status Kit or point this client at an API that permits your frontend origin.",
  "requiresNpm": [
    "react",
    "react-dom"
  ],
  "viteDependencies": {},
  "files": [
    {
      "source": "template/ConfiguredComponent.tsx",
      "target": "ConfiguredComponent.tsx"
    },
    {
      "source": "template/page.tsx",
      "target": "page.tsx"
    },
    {
      "source": "template/settings.json",
      "target": "settings.json"
    }
  ],
  "viteFiles": [
    {
      "source": "template/preview.html",
      "target": "preview.html",
      "shared": true
    },
    {
      "source": "template/preview.tsx",
      "target": "preview.tsx",
      "shared": true
    },
    {
      "source": "template/colly.css",
      "target": "colly.css",
      "shared": true
    }
  ]
}
