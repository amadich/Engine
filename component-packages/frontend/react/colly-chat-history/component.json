{
  "id": "colly-chat-history",
  "name": "Chat History",
  "description": "Import ConfiguredComponent.tsx into your screen.",
  "category": [
    "Frontend",
    "Colly UI",
    "Collaboration"
  ],
  "frameworks": [
    "next-js",
    "react-vite"
  ],
  "technologies": [
    "React"
  ],
  "activation": "inspect",
  "defaultDirectory": "src/app/library/chat-history",
  "preview": true,
  "configTarget": "settings.json",
  "fields": [
    {
      "key": "previewTitle",
      "label": "Preview title",
      "defaultValue": "Chat History"
    },
    {
      "key": "limit",
      "label": "History limit",
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    {
      "key": "title",
      "label": "Title"
    },
    {
      "key": "author",
      "label": "Author"
    },
    {
      "key": "message",
      "label": "Message"
    }
  ],
  "usage": "Import ConfiguredComponent.tsx into your screen.",
  "requiresNpm": [
    "react",
    "react-dom"
  ],
  "viteDependencies": {},
  "files": [
    {
      "source": "template/ConfiguredComponent.tsx",
      "target": "ConfiguredComponent.tsx"
    },
    {
      "source": "template/page.tsx",
      "target": "page.tsx"
    },
    {
      "source": "template/settings.json",
      "target": "settings.json"
    }
  ],
  "viteFiles": [
    {
      "source": "template/preview.html",
      "target": "preview.html",
      "shared": true
    },
    {
      "source": "template/preview.tsx",
      "target": "preview.tsx",
      "shared": true
    },
    {
      "source": "template/colly.css",
      "target": "colly.css",
      "shared": true
    }
  ]
}
