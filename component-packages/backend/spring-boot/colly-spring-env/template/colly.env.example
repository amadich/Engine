# Copy to the project root as .env for Jeridi Engine, or provide real environment variables.
# Use a distinct random JWT secret of at least 32 bytes and a bcrypt hash for the account.
JERIDI_JWT_SECRET=
JERIDI_AUTH_USER=
JERIDI_AUTH_PASSWORD_HASH=
# Required for PostgreSQL; omit these three to use the selected embedded H2 driver.
# SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/app
# SPRING_DATASOURCE_USERNAME=app
# SPRING_DATASOURCE_PASSWORD=
# Set SPRING_JPA_HIBERNATE_DDL_AUTO=update only for a disposable local database.
