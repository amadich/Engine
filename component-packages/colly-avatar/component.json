{
  "id": "colly-avatar",
  "name": "Avatar",
  "description": "Colly UI · Next.js and React + Vite",
  "frameworks": [
    "next-js",
    "react-vite"
  ],
  "category": [
    "Colly UI",
    "Display"
  ],
  "activation": "inspect",
  "defaultDirectory": "src/app/library/avatar",
  "preview": true,
  "configTarget": "settings.json",
  "settingsHint": "These values drive the live example and the reusable ConfiguredComponent export.",
  "fields": [
    {
      "key": "initials",
      "label": "Initials"
    },
    {
      "key": "label",
      "label": "Label"
    }
  ],
  "files": [
    {
      "source": "template/LICENSE",
      "target": "LICENSE"
    },
    {
      "source": "template/avatar.tsx",
      "target": "avatar.tsx"
    },
    {
      "source": "template/page.tsx",
      "target": "page.tsx"
    },
    {
      "source": "template/settings.json",
      "target": "settings.json"
    },
    {
      "source": "template/utils.ts",
      "target": "utils.ts"
    },
    {
      "source": "template/ConfiguredComponent.tsx",
      "target": "ConfiguredComponent.tsx"
    }
  ],
  "requiresNpm": [
    "clsx",
    "radix-ui",
    "react",
    "react-dom",
    "tailwind-merge"
  ],
  "viteDependencies": {
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.5.0"
  },
  "viteFiles": [
    {
      "source": "template/preview.html",
      "target": "preview.html",
      "shared": true
    },
    {
      "source": "template/preview.tsx",
      "target": "preview.tsx",
      "shared": true
    },
    {
      "source": "template/colly.css",
      "target": "colly.css",
      "shared": true
    }
  ]
}
